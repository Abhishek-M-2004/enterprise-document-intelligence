# ==============================================================================
# Multi-Tenant Enterprise Document Intelligence Platform
# Production Environment Variables Template (.env.production.example)
# ==============================================================================
# Copy this file to .env on your production host and populate with strong secrets.
# DO NOT COMMIT THE ACTUAL .env FILE CONTAINING PRODUCTION SECRETS TO VERSION CONTROL.

# --- 1. Application Runtime ---
ENVIRONMENT=production
DEBUG=False
PROJECT_NAME="Enterprise Document Intelligence Platform"
VERSION=1.0.0
LOG_LEVEL=INFO

# --- 2. Security & Cryptographic Tokens ---
# Generate using: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=True
COOKIE_SAMESITE=lax

# Domain Name for SSL & Reverse Proxy
DOMAIN_NAME=docs.yourcompany.com

# Allowed CORS Origins (Public HTTPS domain)
BACKEND_CORS_ORIGINS=["https://docs.yourcompany.com"]

# --- 3. Relational Database (PostgreSQL 16) ---
# Admin credentials used strictly for migrations & initial role bootstrap
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD_MIN_24_CHARS
POSTGRES_DB=doc_intelligence

# Least-Privilege Application Role (Non-Superuser, NOBYPASSRLS)
POSTGRES_APP_USER=docintel_app
POSTGRES_APP_PASSWORD=CHANGE_ME_STRONG_APP_PASSWORD_MIN_24_CHARS

# Database Pool Configuration
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- 4. Message Broker & Cache (Redis 7) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD_MIN_24_CHARS
RATE_LIMIT_FALLBACK_POLICY=memory

# --- 5. Vector Database (Qdrant) ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=CHANGE_ME_STRONG_QDRANT_API_KEY_MIN_24_CHARS
QDRANT_COLLECTION_CHUNKS=enterprise_document_chunks

# --- 6. Large Language Model (LLM) Integration ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-proj-your-production-openai-api-key-here
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=1500
LLM_REQUEST_TIMEOUT=30.0

# --- 7. Ingestion & Retrieval Thresholds ---
MAX_UPLOAD_SIZE_BYTES=52428800
CHUNK_SIZE=512
CHUNK_OVERLAP=50
MAX_CONTEXT_TOKENS=3000
