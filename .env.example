# ==============================================================================
# Enterprise Document Intelligence Platform - Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="Enterprise Document Intelligence Platform"
VERSION=0.1.0
DEBUG=True
LOG_LEVEL=INFO

# Security (Replace with a strong random string in production: openssl rand -hex 32)
SECRET_KEY=dev-insecure-secret-key-replace-in-production-min-32-chars

# CORS Configuration (Comma-separated list of allowed origins)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# PostgreSQL Database Configuration
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_change_me
POSTGRES_DB=doc_intelligence

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Celery Task Queue
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Qdrant Vector Database
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
QDRANT_PREFER_GRPC=False

# Host Port Mapping for Docker Compose
HOST_FRONTEND_PORT=5173
HOST_BACKEND_PORT=8000
HOST_POSTGRES_PORT=5432
HOST_REDIS_PORT=6379
HOST_QDRANT_HTTP_PORT=6333
HOST_QDRANT_GRPC_PORT=6334

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000

# Large Language Model (LLM) Configuration (Phase 6)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=your_openai_api_key_here
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=1500
LLM_REQUEST_TIMEOUT=30.0
MAX_CONTEXT_TOKENS=3000
MAX_HISTORY_TOKENS=1000
